generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
// Restricciones adicionales, índices parciales y RLS: prisma/sql/005_normalized_catalog_orders.sql.
// Singleton, CHECK(id=1) y RLS: prisma/sql/007_cafe_status.sql.
model cafe_settings {
 id Int @id @default(1)
 is_open Boolean @default(true)
 updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
}
// Singleton, límite de anuncios y RLS: prisma/sql/009_promotions.sql.
model promotion_settings {
 id Int @id @default(1)
 items Json @default("[]")
 revision Int @default(0)
 updated_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
}
model products {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 name String
 description String
 image String
 category_id String @db.Uuid
 available Boolean @default(true)
 archived Boolean @default(false)
 created_at DateTime @default(now()) @db.Timestamptz(6)
 category_details categories @relation(fields:[category_id],references:[id],onDelete:Restrict)
 variants product_variants[]
 modifier_groups product_modifier_groups[]
 @@index([category_id],map:"products_category_id_idx")
}
model categories {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 name String @unique
 created_at DateTime @default(now()) @db.Timestamptz(6)
 products products[]
}
model presentations {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 key String @unique
 label String
 volume_ml Int?
 variants product_variants[]
}
model product_variants {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 product_id String @db.Uuid
 presentation_id String @db.Uuid
 price Decimal @db.Decimal(10,2)
 position Int @default(0)
 available Boolean @default(true)
 archived Boolean @default(false)
 product products @relation(fields:[product_id],references:[id],onDelete:Cascade)
 presentation presentations @relation(fields:[presentation_id],references:[id],onDelete:Restrict)
 items order_items[]
}
model modifier_groups {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 name String @unique
 min_selections Int @default(0)
 max_selections Int @default(1)
 options modifier_options[]
 products product_modifier_groups[]
}
model modifier_options {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 group_id String @db.Uuid
 name String
 price Decimal @db.Decimal(10,2)
 available Boolean @default(true)
 group modifier_groups @relation(fields:[group_id],references:[id],onDelete:Restrict)
 purchased_options order_item_options[]
 @@unique([group_id,name])
}
model product_modifier_groups {
 product_id String @db.Uuid
 group_id String @db.Uuid
 product products @relation(fields:[product_id],references:[id],onDelete:Cascade)
 group modifier_groups @relation(fields:[group_id],references:[id],onDelete:Restrict)
 @@id([product_id,group_id])
}
model order_sessions {
 token_hash String @id
 created_at DateTime @default(now()) @db.Timestamptz(6)
 expires_at DateTime @db.Timestamptz(6)
 orders orders[]
}
model orders {
 notes String @default("")
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 folio BigInt @unique @default(autoincrement())
 session_hash String
 idempotency_key String @db.Uuid
 request_hash String
 status String @default("new")
 currency String @default("MXN")
 total Decimal @db.Decimal(12,2)
 created_at DateTime @default(now()) @db.Timestamptz(6)
 updated_at DateTime @default(now()) @db.Timestamptz(6)
 session order_sessions @relation(fields:[session_hash],references:[token_hash],onDelete:Restrict)
 items order_items[]
 history order_status_history[]
 @@unique([session_hash,idempotency_key])
 @@index([created_at(sort:Desc),id(sort:Desc)],map:"orders_queue_idx")
 @@index([session_hash,created_at(sort:Desc)],map:"orders_session_idx")
}
model order_items {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 order_id String @db.Uuid
 variant_id String @db.Uuid
 product_name String
 presentation_label String
 volume_ml Int?
 quantity Int
 base_price Decimal @db.Decimal(10,2)
 unit_price Decimal @db.Decimal(10,2)
 line_total Decimal @db.Decimal(12,2)
 position Int
 order orders @relation(fields:[order_id],references:[id],onDelete:Restrict)
 variant product_variants @relation(fields:[variant_id],references:[id],onDelete:Restrict)
 options order_item_options[]
 @@index([order_id],map:"order_items_order_idx")
 @@index([variant_id],map:"order_items_variant_idx")
}
model order_item_options {
 item_id String @db.Uuid
 option_id String @db.Uuid
 group_name String
 option_name String
 price Decimal @db.Decimal(10,2)
 item order_items @relation(fields:[item_id],references:[id],onDelete:Restrict)
 option modifier_options @relation(fields:[option_id],references:[id],onDelete:Restrict)
 @@id([item_id,option_id])
}
model order_status_history {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 order_id String @db.Uuid
 from_status String?
 to_status String
 // FK a cafe_access.accounts gestionada en SQL; solo alias ficticios.
 actor_account_id String? @db.Uuid
 created_at DateTime @default(now()) @db.Timestamptz(6)
 order orders @relation(fields:[order_id],references:[id],onDelete:Restrict)
 @@index([order_id],map:"order_history_order_idx")
}
