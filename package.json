{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "type": "module",
  "author": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:render": "tsx src/server.ts",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/socket.test.ts tests/push.test.ts tests/order-notes-panel.test.mjs tests/promotions-panel.test.mjs tests/products-panel.test.mjs tests/cafe-status.local.test.ts tests/promotions.local.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/*.integration.test.ts",
    "postinstall": "prisma skills sync || exit 0",
    "access:migrate": "node scripts/migrate-access.mjs",
    "cafe:migrate": "node scripts/migrate-cafe-status.mjs",
    "notes:migrate": "node scripts/migrate-order-notes.mjs",
    "promotions:migrate": "node scripts/migrate-promotions.mjs",
    "media:migrate": "node scripts/migrate-media-files.mjs",
    "promotions:seed": "tsx scripts/seed-promotions.ts",
    "test:promotions": "tsx --test tests/promotions.local.test.ts tests/promotions-panel.test.mjs",
    "test:cafe": "tsx --test tests/cafe-status.local.test.ts",
    "test:notes": "tsx --test tests/cafe-status.local.test.ts tests/order-notes-panel.test.mjs",
    "account:create": "tsx scripts/create-admin.ts",
    "test:access": "tsx --test tests/access.integration.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
